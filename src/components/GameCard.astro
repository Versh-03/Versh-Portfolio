<div class="dino-card bento-card" id="dino-component-root">
  <div class="card-header">
    <span class="card-label">// interactive_terminal</span>
  </div>

  <div class="terminal-screen" id="terminal-screen">
    <div class="console-log" id="console-log">
      <p class="system-line">AdarshOS v2.0.26 Core Initialized...</p>
      <p class="system-line text-muted">Type 'play' to load the emulator module.</p>
    </div>
    
    <div class="input-line">
      <span class="prompt-symbol">&gt;</span>
      <input 
        type="text" 
        id="terminal-input" 
        autocomplete="off" 
        autocorrect="off" 
        autocapitalize="off" 
        spellcheck="false"
        placeholder="..."
      />
    </div>
  </div>

  <div class="game-viewport hidden" id="game-viewport">
    <canvas id="dino-canvas" width="400" height="150"></canvas>
    <div class="game-overlay hidden" id="game-overlay">
      <p class="game-over-text">GAME OVER</p>
      <p class="restart-text">Press Space to Retry</p>
    </div>
    <div class="score-board">
      <span>SCORE: <span id="current-score">00000</span></span>
    </div>
  </div>
</div>

<style>
  .dino-card {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    height: 100%;
    background: linear-gradient(180deg, var(--burnt-coffee) 0%, var(--balsamico) 100%) !important;
    border-radius: 16px;
    padding: 1.25rem;
    overflow: hidden;
  }

  .card-label {
    font-size: 0.7rem;
    color: var(--whiskey-sour);
    font-weight: 700;
  }

  .terminal-screen {
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    flex-grow: 1;
    font-family: var(--font-mono);
    font-size: 0.85rem;
    gap: 0.5rem;
  }

  .system-line {
    color: var(--champagne);
    line-height: 1.4;
  }
  
  .system-line.text-muted {
    color: var(--whiskey-sour);
    opacity: 0.8;
  }

  .input-line {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    border-top: 1px solid rgba(133, 67, 30, 0.2);
    padding-top: 0.5rem;
  }

  .prompt-symbol {
    color: var(--whiskey-sour);
    font-weight: 700;
  }

  #terminal-input {
    background: transparent;
    border: none;
    outline: none;
    color: var(--champagne);
    font-family: var(--font-mono);
    font-size: 0.85rem;
    width: 100%;
  }

  .game-viewport {
    position: relative;
    width: 100%;
    background: rgba(21, 12, 12, 0.5);
    border: 1px solid rgba(133, 67, 30, 0.3);
    border-radius: 8px;
    overflow: hidden;
  }

  #dino-canvas {
    display: block;
    width: 100%;
    height: auto;
  }

  .score-board {
    position: absolute;
    top: 8px;
    right: 8px;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 700;
    color: var(--whiskey-sour);
  }

  .game-overlay {
    position: absolute;
    inset: 0;
    background: rgba(21, 12, 12, 0.9);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.25rem;
  }

  .game-over-text {
    font-family: var(--font-display);
    font-size: 1.2rem;
    font-weight: 700;
    color: var(--champagne);
  }

  .restart-text {
    font-family: var(--font-mono);
    font-size: 0.65rem;
    color: var(--whiskey-sour);
  }

  .hidden { display: none !important; }
</style>

<script is:inline>
  (() => {
    const root = document.getElementById('dino-component-root');
    const input = document.getElementById('terminal-input');
    const screen = document.getElementById('terminal-screen');
    const viewport = document.getElementById('game-viewport');
    const canvas = document.getElementById('dino-canvas');
    const overlay = document.getElementById('game-overlay');
    const scoreElement = document.getElementById('current-score');
    
    if (!root || !input || !canvas) return;
    const ctx = canvas.getContext('2d');

    let gameActive = false;
    let animationId = null;
    let score = 0;
    let speed = 4;
    
    let dino = { x: 35, y: 110, w: 20, h: 24, vy: 0, grounded: true };
    let obstacles = [];
    let spawnTimer = 0;

    // Command parser handling
    input.addEventListener('keydown', (e) => {
      if (e.key === 'Enter') {
        const cmd = input.value.trim().toLowerCase();
        if (cmd === 'play') {
          screen.classList.add('hidden');
          viewport.classList.remove('hidden');
          startGame();
        }
        input.value = '';
      }
    });

    // MOUSE EXIT HANDLER: Tear down loop and snap back to prompt if mouse leaves component
    root.addEventListener('mouseleave', () => {
      resetToTerminal();
    });

    function resetToTerminal() {
      gameActive = false;
      if (animationId) cancelAnimationFrame(animationId);
      window.removeEventListener('keydown', handleControls);
      viewport.removeEventListener('touchstart', handleTouch);
      viewport.classList.add('hidden');
      screen.classList.remove('hidden');
      overlay.classList.add('hidden');
    }

    function startGame() {
      gameActive = true;
      score = 0;
      speed = 4.5;
      obstacles = [];
      dino.y = 110;
      dino.vy = 0;
      dino.grounded = true;
      scoreElement.textContent = '00000';
      overlay.classList.add('hidden');
      
      window.removeEventListener('keydown', handleControls);
      window.addEventListener('keydown', handleControls);
      viewport.removeEventListener('touchstart', handleTouch);
      viewport.addEventListener('touchstart', handleTouch, { passive: false });
      loop();
    }

    function handleControls(e) {
      if (e.code === 'Space' || e.code === 'ArrowUp') {
        e.preventDefault();
        if (overlay.classList.contains('hidden') === false) {
          startGame();
        } else if (dino.grounded) {
          dino.vy = -7;
          dino.grounded = false;
        }
      }
    }
    function handleTouch(e) {
      e.preventDefault(); // Stops mobile screen from scrolling or zooming while tapping
      if (overlay.classList.contains('hidden') === false) {
        startGame();
      } else if (dino.grounded) {
        dino.vy = -7;
        dino.grounded = false;
      }
    }

    // DRAW MASCOT SPRITE VECTOR LOGIC
    function drawStylizedDino(ctx, x, y) {
      ctx.fillStyle = '#EACEAA'; // var(--champagne)
      // Body & Head block
      ctx.fillRect(x + 4, y, 12, 8); 
      ctx.fillRect(x, y + 6, 16, 12);
      // Snout
      ctx.fillRect(x + 10, y + 2, 8, 4);
      // Tail
      ctx.fillRect(x - 4, y + 8, 4, 6);
      // Feet execution states
      if (gameActive && Math.floor(score / 20) % 2 === 0) {
        ctx.fillRect(x + 2, y + 18, 3, 6); // Left foot down
      } else {
        ctx.fillRect(x + 10, y + 18, 3, 6); // Right foot down
      }
    }

    function loop() {
      if (!gameActive) return;
      animationId = requestAnimationFrame(loop);
      ctx.clearRect(0, 0, canvas.width, canvas.height);

      // Floor line
      ctx.strokeStyle = '#85431E';
      ctx.lineWidth = 2;
      ctx.beginPath();
      ctx.moveTo(0, 134);
      ctx.lineTo(canvas.width, 134);
      ctx.stroke();

      // Physics engine
      dino.vy += 0.4;
      dino.y += dino.vy;

      if (dino.y >= 110) {
        dino.y = 110;
        dino.vy = 0;
        dino.grounded = true;
      }

      // Draw upgraded dino character
      drawStylizedDino(ctx, dino.x, dino.y);

      // Obstacle management
      spawnTimer++;
      if (spawnTimer > Math.max(45, 80 - Math.floor(score / 15))) {
        if (Math.random() > 0.35) {
          obstacles.push({ x: canvas.width, y: 114, w: 10, h: 20 });
        }
        spawnTimer = 0;
      }

      for (let i = obstacles.length - 1; i >= 0; i--) {
        let obs = obstacles[i];
        obs.x -= speed;

        // Draw obstacle cactus spike
        ctx.fillStyle = '#D39858';
        ctx.fillRect(obs.x, obs.y, obs.w, obs.h);

        // AABB Collision tracking
        if (
          dino.x < obs.x + obs.w &&
          dino.x + dino.w > obs.x &&
          dino.y < obs.y + obs.h &&
          dino.y + dino.h > obs.y
        ) {
          gameActive = false;
          cancelAnimationFrame(animationId);
          overlay.classList.remove('hidden');
        }

        if (obs.x + obs.w < 0) {
          obstacles.splice(i, 1);
          score += 10;
          speed += 0.08;
          scoreElement.textContent = String(score).padStart(5, '0');
        }
      }
    }
  })();
</script>