---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout>
    <div class="error-page">
        <div class="glow glow-a"></div>
        <div class="glow glow-b"></div>

        <canvas id="neural-canvas" aria-hidden="true"></canvas>

        <div class="content">
            <div class="cat" id="cat">
                <span class="cat-face">ฅ^•ﻌ•^ฅ</span>
            </div>

            <div class="code-404" id="code-404">
                <span class="code-text">404</span>
            </div>

            <h1 class="headline">Model Prediction: Page Not Found</h1>

            <div class="panel bento-card theme-dark-card" id="panel">
                <div class="panel-tag muted-label">
                    <span class="dot-ping-wrap">
                        <span class="dot-ping"></span>
                        <span class="dot"></span>
                    </span>
                    AI Analysis
                </div>

                <div class="log" id="log"></div>

                <div class="result" id="result" hidden>
                    <div class="result-title">Prediction Complete</div>
                    <div class="result-line">
                        Result:{" "}
                        <span class="result-negative">
                            This page does not exist.
                        </span>
                    </div>
                    <div class="confidence-row">
                        <span class="confidence-label muted-label">
                            Confidence
                        </span>
                        <div class="confidence-bar">
                            <div
                                class="confidence-fill"
                                id="confidence-fill"
                            ></div>
                        </div>
                        <span class="confidence-value" id="confidence-value">
                            0.00%
                        </span>
                    </div>
                </div>
            </div>

            <button class="retrain-btn" id="retrain-btn" hidden>
                ← Retrain Model
            </button>

            <p class="humor" id="humor">
                Possible cause: Versh forgot to train this route.
            </p>
        </div>
    </div>
</BaseLayout>

<style>
    .error-page {
        position: relative;
        min-height: 100vh;
        width: 100%;
        overflow: hidden;
        background: var(--bg);
        color: var(--text);
        display: flex;
        align-items: center;
        justify-content: center;
        font-family: var(--font-mono);
    }

    .glow {
        position: absolute;
        border-radius: 50%;
        pointer-events: none;
        filter: blur(120px);
    }
    .glow-a {
        top: -8rem;
        left: -8rem;
        width: 26rem;
        height: 26rem;
        background: rgba(211, 152, 88, 0.12);
    }
    .glow-b {
        bottom: -10rem;
        right: -6rem;
        width: 26rem;
        height: 26rem;
        background: rgba(133, 67, 30, 0.18);
    }

    #neural-canvas {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
    }

    .content {
        position: relative;
        z-index: 10;
        max-width: 40rem;
        width: 100%;
        padding: 4rem 1.25rem;
        display: flex;
        flex-direction: column;
        align-items: center;
        text-align: center;
    }

    .cat {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 0.2rem;
        margin-bottom: 0.75rem;
        opacity: 0;
        animation:
            fade-up 0.6s ease-out 0.05s forwards,
            bob 3.4s ease-in-out 0.8s infinite;
    }

    .cat-face {
        font-size: 1.4rem;
        color: var(--whiskey-sour);
        letter-spacing: 0.02em;
    }

    .cat-caption {
        font-size: 0.68rem;
        color: var(--text-muted);
        opacity: 0.75;
        letter-spacing: 0.01em;
    }

    @keyframes bob {
        0%,
        100% {
            transform: translateY(0);
        }
        50% {
            transform: translateY(-5px);
        }
    }

    .code-404 {
        opacity: 0;
        filter: blur(8px);
        animation: reveal-404 0.8s ease-out 0.15s forwards;
    }

    @keyframes reveal-404 {
        to {
            opacity: 1;
            filter: blur(0);
        }
    }

    .code-text {
        font-family: var(--font-display);
        font-size: clamp(4.5rem, 12vw, 8rem);
        font-weight: 700;
        line-height: 1;
        letter-spacing: -0.02em;
        background: linear-gradient(
            180deg,
            var(--champagne) 0%,
            var(--whiskey-sour) 55%,
            var(--honey-garlic) 100%
        );
        -webkit-background-clip: text;
        background-clip: text;
        color: transparent;
    }

    .headline {
        margin-top: 0.75rem;
        font-family: var(--font-display);
        font-size: clamp(1.05rem, 2.4vw, 1.25rem);
        font-weight: 500;
        color: var(--champagne);
        opacity: 0;
        transform: translateY(10px);
        animation: fade-up 0.6s ease-out 0.4s forwards;
    }

    @keyframes fade-up {
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    .panel {
        margin-top: 2rem;
        width: 100%;
        border-radius: 1rem;
        background: rgba(52, 21, 15, 0.55);
        backdrop-filter: blur(18px);
        -webkit-backdrop-filter: blur(18px);
        box-shadow: 0 0 40px -18px rgba(211, 152, 88, 0.35);
        padding: 1.25rem 1.5rem;
        text-align: left;
        opacity: 0;
        transform: translateY(16px);
        animation: fade-up 0.6s ease-out 0.55s forwards;
    }

    .panel-tag {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        font-size: 0.72rem;
        text-transform: uppercase;
        letter-spacing: 0.06em;
        margin-bottom: 0.75rem;
    }

    .dot-ping-wrap {
        position: relative;
        display: inline-flex;
        height: 0.5rem;
        width: 0.5rem;
    }
    .dot-ping {
        position: absolute;
        inset: 0;
        border-radius: 9999px;
        background: var(--whiskey-sour);
        opacity: 0.6;
        animation: ping 1.6s cubic-bezier(0, 0, 0.2, 1) infinite;
    }
    .dot {
        position: relative;
        display: inline-flex;
        height: 0.5rem;
        width: 0.5rem;
        border-radius: 9999px;
        background: var(--whiskey-sour);
    }
    @keyframes ping {
        75%,
        100% {
            transform: scale(2.2);
            opacity: 0;
        }
    }

    .log {
        font-size: 0.92rem;
        line-height: 1.7;
    }

    .log-line {
        display: flex;
        align-items: flex-start;
        gap: 0.5rem;
        color: var(--champagne);
        opacity: 0.85;
    }

    .log-line .arrow {
        color: var(--honey-garlic);
    }

    .cursor {
        display: inline-block;
        width: 2px;
        height: 1em;
        margin-left: 2px;
        transform: translateY(2px);
        background: var(--whiskey-sour);
        animation: blink 1s step-end infinite;
    }

    @keyframes blink {
        50% {
            opacity: 0;
        }
    }

    .result {
        margin-top: 1rem;
        padding-top: 1rem;
        border-top: 1px solid rgba(133, 67, 30, 0.35);
        opacity: 0;
        animation: fade-up 0.5s ease-out forwards;
    }

    .result-title {
        font-family: var(--font-display);
        font-size: 0.95rem;
        font-weight: 600;
        color: var(--champagne);
    }

    .result-line {
        margin-top: 0.25rem;
        font-size: 0.9rem;
        color: var(--text-muted);
    }

    .result-negative {
        color: var(--whiskey-sour);
    }

    .confidence-row {
        margin-top: 0.75rem;
        display: flex;
        align-items: center;
        gap: 0.75rem;
    }

    .confidence-label {
        font-size: 0.7rem;
        text-transform: uppercase;
        letter-spacing: 0.05em;
        white-space: nowrap;
    }

    .confidence-bar {
        flex: 1;
        height: 0.35rem;
        border-radius: 9999px;
        background: rgba(211, 152, 88, 0.15);
        overflow: hidden;
    }

    .confidence-fill {
        height: 100%;
        width: 0%;
        border-radius: 9999px;
        background: linear-gradient(
            90deg,
            var(--honey-garlic),
            var(--whiskey-sour)
        );
        transition: width 0.9s ease-out;
    }

    .confidence-value {
        font-size: 0.78rem;
        color: var(--whiskey-sour);
        white-space: nowrap;
    }

    .retrain-btn {
        margin-top: 2rem;
        font-family: var(--font-mono);
        font-size: 0.85rem;
        font-weight: 600;
        color: var(--balsamico);
        background: linear-gradient(
            90deg,
            var(--whiskey-sour),
            var(--champagne)
        );
        border: none;
        border-radius: 9999px;
        padding: 0.7rem 1.6rem;
        cursor: pointer;
        box-shadow: 0 0 25px -8px rgba(211, 152, 88, 0.6);
        transition:
            box-shadow 0.2s ease,
            transform 0.1s ease;
        opacity: 0;
        animation: fade-up 0.5s ease-out 0.15s forwards;
    }

    .retrain-btn:hover {
        box-shadow: 0 0 35px -6px rgba(211, 152, 88, 0.85);
    }

    .retrain-btn:active {
        transform: scale(0.98);
    }

    .humor {
        margin-top: 2.5rem;
        font-size: 0.75rem;
        color: var(--text-muted);
        opacity: 0;
        animation: humor-fade-up 0.6s ease-out 0.1s forwards;
    }

    @keyframes humor-fade-up {
        to {
            opacity: 0.7;
            transform: translateY(0);
        }
    }

    @media (prefers-reduced-motion: reduce) {
        .cat,
        .code-404,
        .headline,
        .panel,
        .result,
        .retrain-btn,
        .humor {
            animation: none !important;
            opacity: 1 !important;
            transform: none !important;
            filter: none !important;
        }
        .dot-ping,
        .cursor {
            animation: none !important;
        }
    }
</style>

<script>
    const LOG_LINES = [
        "Initializing page search...",
        "Scanning neural pathways...",
        "Searching database...",
        "Analyzing URL...",
    ];

    const prefersReducedMotion = window.matchMedia(
        "(prefers-reduced-motion: reduce)",
    ).matches;

    const logEl = document.getElementById("log");
    const resultEl = document.getElementById("result");
    const retrainBtn = document.getElementById("retrain-btn");
    const confidenceFill = document.getElementById("confidence-fill");
    const confidenceValue = document.getElementById("confidence-value");

    retrainBtn?.addEventListener("click", () => {
        window.location.href = "/";
    });

    function revealResult() {
        resultEl.hidden = false;
        retrainBtn.hidden = false;

        const target = 99.97;
        const duration = prefersReducedMotion ? 0 : 900;
        const start = performance.now();

        confidenceFill.style.width = target + "%";

        function tick(now) {
            const p =
                duration === 0 ? 1 : Math.min(1, (now - start) / duration);
            const value = (target * p).toFixed(2);
            confidenceValue.textContent = value + "%";
            if (p < 1) requestAnimationFrame(tick);
        }
        requestAnimationFrame(tick);
    }

    function typeLines(lines, onComplete) {
        let lineIndex = 0;

        function nextLine() {
            if (lineIndex >= lines.length) {
                onComplete();
                return;
            }
            const text = lines[lineIndex];
            const row = document.createElement("div");
            row.className = "log-line";
            const arrow = document.createElement("span");
            arrow.className = "arrow";
            arrow.textContent = "›";
            const typed = document.createElement("span");
            const cursor = document.createElement("span");
            cursor.className = "cursor";
            row.appendChild(arrow);
            row.appendChild(typed);
            row.appendChild(cursor);
            logEl.appendChild(row);

            let charIndex = 0;
            function typeChar() {
                charIndex += 1;
                typed.textContent = text.slice(0, charIndex);
                if (charIndex < text.length) {
                    setTimeout(typeChar, 18);
                } else {
                    cursor.remove();
                    setTimeout(() => {
                        lineIndex += 1;
                        nextLine();
                    }, 260);
                }
            }
            typeChar();
        }

        nextLine();
    }

    if (prefersReducedMotion) {
        LOG_LINES.forEach((text) => {
            const row = document.createElement("div");
            row.className = "log-line";
            row.innerHTML = `<span class="arrow">›</span><span>${text}</span>`;
            logEl.appendChild(row);
        });
        revealResult();
    } else {
        typeLines(LOG_LINES, revealResult);
    }

    // ---- neural network canvas ----
    const canvas = document.getElementById("neural-canvas");
    const ctx = canvas.getContext("2d");
    let width = 0;
    let height = 0;
    let dpr = Math.min(window.devicePixelRatio || 1, 2);
    let nodes = [];
    let particles = [];
    let frameId = null;

    const COLOR_EDGE = "133, 67, 30";
    const COLOR_NODE = "211, 152, 88";
    const COLOR_PARTICLE = "234, 206, 170";

    function resize() {
        const rect = canvas.getBoundingClientRect();
        width = rect.width;
        height = rect.height;
        canvas.width = width * dpr;
        canvas.height = height * dpr;
        ctx.setTransform(dpr, 0, 0, dpr, 0, 0);

        const area = width * height;
        const count = Math.max(
            24,
            Math.min(70, Math.round((area / 900000) * 46)),
        );
        nodes = Array.from({ length: count }, () => ({
            x: Math.random() * width,
            y: Math.random() * height,
            vx: (Math.random() - 0.5) * 0.18,
            vy: (Math.random() - 0.5) * 0.18,
            r: Math.random() * 1.4 + 1,
            pulse: Math.random() * Math.PI * 2,
        }));
    }

    function drawStatic() {
        resize();
        ctx.clearRect(0, 0, width, height);
        const maxDist = Math.min(160, width / 5);
        for (let i = 0; i < nodes.length; i++) {
            for (let j = i + 1; j < nodes.length; j++) {
                const a = nodes[i];
                const b = nodes[j];
                const dx = a.x - b.x;
                const dy = a.y - b.y;
                const dist = Math.sqrt(dx * dx + dy * dy);
                if (dist < maxDist) {
                    const alpha = (1 - dist / maxDist) * 0.35;
                    ctx.strokeStyle = `rgba(${COLOR_EDGE}, ${alpha})`;
                    ctx.lineWidth = 0.6;
                    ctx.beginPath();
                    ctx.moveTo(a.x, a.y);
                    ctx.lineTo(b.x, b.y);
                    ctx.stroke();
                }
            }
        }
        for (const n of nodes) {
            ctx.fillStyle = `rgba(${COLOR_NODE}, 0.55)`;
            ctx.beginPath();
            ctx.arc(n.x, n.y, n.r, 0, Math.PI * 2);
            ctx.fill();
        }
    }

    function draw() {
        ctx.clearRect(0, 0, width, height);

        for (const n of nodes) {
            n.x += n.vx;
            n.y += n.vy;
            n.pulse += 0.02;
            if (n.x < 0 || n.x > width) n.vx *= -1;
            if (n.y < 0 || n.y > height) n.vy *= -1;
        }

        const maxDist = Math.min(160, width / 5);
        for (let i = 0; i < nodes.length; i++) {
            for (let j = i + 1; j < nodes.length; j++) {
                const a = nodes[i];
                const b = nodes[j];
                const dx = a.x - b.x;
                const dy = a.y - b.y;
                const dist = Math.sqrt(dx * dx + dy * dy);
                if (dist < maxDist) {
                    const alpha = (1 - dist / maxDist) * 0.35;
                    const flicker = 0.6 + 0.4 * Math.sin(a.pulse + b.pulse);
                    ctx.strokeStyle = `rgba(${COLOR_EDGE}, ${alpha * flicker})`;
                    ctx.lineWidth = 0.6;
                    ctx.beginPath();
                    ctx.moveTo(a.x, a.y);
                    ctx.lineTo(b.x, b.y);
                    ctx.stroke();
                }
            }
        }

        if (Math.random() < 0.045 && nodes.length > 2) {
            const a = nodes[Math.floor(Math.random() * nodes.length)];
            const b = nodes[Math.floor(Math.random() * nodes.length)];
            particles.push({ a, b, t: 0 });
        }
        particles = particles.filter((p) => p.t <= 1);
        for (const p of particles) {
            p.t += 0.02;
            const x = p.a.x + (p.b.x - p.a.x) * p.t;
            const y = p.a.y + (p.b.y - p.a.y) * p.t;
            const grad = ctx.createRadialGradient(x, y, 0, x, y, 6);
            grad.addColorStop(0, `rgba(${COLOR_PARTICLE}, 0.9)`);
            grad.addColorStop(1, `rgba(${COLOR_PARTICLE}, 0)`);
            ctx.fillStyle = grad;
            ctx.beginPath();
            ctx.arc(x, y, 6, 0, Math.PI * 2);
            ctx.fill();
        }

        for (const n of nodes) {
            const glow = 0.7 + 0.3 * Math.sin(n.pulse);
            ctx.fillStyle = `rgba(${COLOR_NODE}, ${0.55 * glow})`;
            ctx.beginPath();
            ctx.arc(n.x, n.y, n.r, 0, Math.PI * 2);
            ctx.fill();
        }

        frameId = requestAnimationFrame(draw);
    }

    window.addEventListener("resize", () => {
        if (prefersReducedMotion) {
            drawStatic();
        } else {
            resize();
        }
    });

    if (prefersReducedMotion) {
        drawStatic();
    } else {
        resize();
        draw();
    }

    document.addEventListener("astro:before-swap", () => {
        if (frameId) cancelAnimationFrame(frameId);
    });
</script>
